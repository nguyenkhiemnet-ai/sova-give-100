<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="sovaGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#059669" />
      <stop offset="100%" stop-color="#047857" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#047857" flood-opacity="0.3" />
    </filter>
  </defs>
  <rect width="512" height="512" rx="128" fill="url(#sovaGrad)" filter="url(#shadow)" />
  <g fill="none" stroke="#ffffff" stroke-width="28" stroke-linecap="round" stroke-linejoin="round" transform="translate(76, 76)">
    <!-- Stylized Heart and Handshake -->
    <path d="M180 80 C 130 10, 50 20, 30 85 C 10 150, 80 230, 180 300 C 280 230, 350 150, 330 85 C 310 20, 230 10, 180 80 Z" stroke-width="24" fill="rgba(255,255,255,0.12)" />
    <path d="M120 180 L 160 220 L 240 140" stroke-width="32" stroke="#ffffff" />
    <circle cx="180" cy="90" r="14" fill="#ffffff" stroke="none" />
  </g>
</svg>
